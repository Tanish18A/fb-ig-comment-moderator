    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body;\nlet comments = [];\n\nfor (const entry of body.entry || []) {\n  for (const change of entry.changes || []) {\n    const value = change.value || {};\n    if (change.field === 'feed' && value.item === 'comment') {\n      comments.push({\n        platform: 'facebook',\n        comment_id: value.comment_id,\n        post_id: value.post_id,\n        message: value.message,\n        from: value.from ? value.from.name : null\n      });\n    }\n    if (change.field === 'comments') {\n      comments.push({\n        platform: 'instagram',\n        comment_id: value.id,\n        post_id: value.media ? value.media.id : null,\n        message: value.text,\n        from: value.from ? value.from.username : null\n      });\n    }\n  }\n}\n\n// Agar message hi nahi hai (empty comment / sticker / photo comment) to skip\nreturn comments.filter(c => c.comment_id && c.message).map(c => ({ json: c }));"
      },
