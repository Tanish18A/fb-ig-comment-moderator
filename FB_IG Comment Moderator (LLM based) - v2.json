    {
      "parameters": {
        "jsCode": "// Signature verify: Meta ke raw bytes pe HMAC hona chahiye, JSON.stringify(parsed body) pe nahi.\n// Isliye webhook node me \"Raw Body\" option enabled hai aur raw bytes yahan binary se nikal rahe hain.\nconst crypto = require('crypto');\nconst item = $input.first();\n\nconst rawBodyBase64 = item.binary?.data?.data;\nif (!rawBodyBase64) {\n  throw new Error('Raw body not found - \"Raw Body\" option webhook node me enable karo');\n}\nconst rawBodyStr = Buffer.from(rawBodyBase64, 'base64').toString('utf8');\n\nconst signature = item.json.headers['x-hub-signature-256'] || '';\nconst appSecret = $env.META_APP_SECRET;\nif (!appSecret) {\n  throw new Error('META_APP_SECRET environment variable set nahi hai (n8n settings > environment variables)');\n}\n\nconst expected = 'sha256=' + crypto.createHmac('sha256', appSecret).update(rawBodyStr).digest('hex');\n\nconst sigBuf = Buffer.from(signature);\nconst expBuf = Buffer.from(expected);\nconst valid = sigBuf.length === expBuf.length && crypto.timingSafeEqual(sigBuf, expBuf);\n\nif (!valid) {\n  throw new Error('Invalid webhook signature - request rejected');\n}\n\nconst body = JSON.parse(rawBodyStr);\nreturn [{ json: { body } }];"
      },
      "id": "0d522f47-5668-47ba-b58d-2cdc93ad9639",
      "name": "Verify Webhook Signature1",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1920,
        3744
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a comment moderation assistant for a business Instagram/Facebook page. The comment may be in English, Hindi, or Hinglish (romanized Hindi). Classify the following comment strictly as one of: ABUSIVE, SPAM, or GENUINE.\n\nABUSIVE = contains gaali/abuse/hate/threats in any language or script.\nSPAM = promo links, bot-like, irrelevant, scam, repeated characters.\nGENUINE = a normal, on-topic comment/question.\n\nIf GENUINE, also write a short, friendly, brand-appropriate reply in the SAME language/tone as the comment.\nIf ABUSIVE or SPAM, reply must be an empty string.\n\nRespond ONLY in this exact JSON format, no extra text, no markdown fences:\n{\"classification\": \"ABUSIVE|SPAM|GENUINE\", \"reply\": \"reply text or empty string\"}\n\nComment: {{$json.message}}"
      },
      "id": "d6fcd300-2f61-4c4d-8a38-43b912a55ff0",
      "name": "Basic LLM Chain - Classify Comment1",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.5,
      "position": [
        2368,
        3744
      ]
    },
    {
      "parameters": {
        "jsCode": "const raw = ($input.first().json.text || $input.first().json.output || '').toString();\nlet parsed;\ntry {\n  const cleaned = raw.replace(/```json|```/g, '').trim();\n  parsed = JSON.parse(cleaned);\n} catch (e) {\n  // Fail-safe: agar model ka output parse na ho paye, SPAM treat karo (delete honi chahiye, auto-reply nahi)\n  parsed = { classification: 'SPAM', reply: '' };\n}\n\nlet classification = (parsed.classification || 'SPAM').toString().trim().toUpperCase();\nif (!['ABUSIVE', 'SPAM', 'GENUINE'].includes(classification)) {\n  classification = 'SPAM';\n}\n\nconst original = $('Parse Comment Payload1').first().json;\nreturn [{\n  json: {\n    ...original,\n    classification,\n    reply: (parsed.reply || '').toString().trim()\n  }\n}];"
      },
